# BiblioTech — Variables de Entorno
# Copia este fichero como .env.local y rellena los valores
# NUNCA subas .env.local a Git

# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# ─── Web Push / VAPID ──────────────────────────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# ─── Cron Jobs ─────────────────────────────────────────────────────────────────
# Secreto para proteger los cron jobs de Vercel
# Generar con: openssl rand -hex 32
CRON_SECRET=....

# ─── Analytics ────────────────────────────────────────────────────────────────
# ID del contenedor de Google Tag Manager (ej: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ─── E2E Tests ─────────────────────────────────────────────────────────────────
# Credenciales de prueba para tests E2E (solo desarrollo)
E2E_ADMIN_EMAIL=admin@yourdomain.com
E2E_ADMIN_PASSWORD=your-admin-user-password
E2E_USER_EMAIL=user@yourdomain.com
E2E_USER_PASSWORD=your-user-password

